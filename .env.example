# ==============================================================================
# AICONNEX Industrial Data Agent — Environment Configuration Template
# Subagent: AICONNEX_Data_Readiness_v1 (Flowise Agentflow V2)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OpenRouter Gateway & Model Routing
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary Reasoning, SQL, Python & Assessment Model
MODEL_REASONING_ID=deepseek/deepseek-v3.2
MODEL_REASONING_TEMPERATURE=0.0
MODEL_REASONING_MAX_TOKENS=2500

# Multimodal Specialist (Invoked ONLY when rendered sheet images are inspected)
MODEL_MULTIMODAL_ID=google/gemini-2.5-flash
MODEL_MULTIMODAL_TEMPERATURE=0.1
MODEL_MULTIMODAL_MAX_TOKENS=2000

# Report Drafting (Reusing primary reasoning model initially to preserve precision)
MODEL_REPORT_ID=deepseek/deepseek-v3.2

# ------------------------------------------------------------------------------
# 2. Flowise Orchestration & Agent-as-Tool Binding
# ------------------------------------------------------------------------------
FLOWISE_HOST=http://localhost:3000
FLOWISE_API_KEY=your_flowise_api_key_here
FLOWISE_AGENTFLOW_ID=AICONNEX_Data_Readiness_v1
FLOWISE_SESSION_SECRET=aiconnex_flowise_session_secret_change_in_prod

# ------------------------------------------------------------------------------
# 3. Authenticated Tool Gateway & Backend Verification Gate
# ------------------------------------------------------------------------------
DATA_AGENT_GATEWAY_HOST=0.0.0.0
DATA_AGENT_GATEWAY_PORT=8000
DATA_AGENT_API_SECRET=your_internal_gateway_secret_key

# Investigation Limits & Budgets
MAX_INVESTIGATION_TOOL_CALLS_PER_TURN=20
MAX_REPAIR_LOOPS=2
MAX_PREVIEW_ROWS=25
TOOL_QUERY_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 4. Storage & Persistence (Investigations, Findings, Evidence Records)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aiconnex_data_agent
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./data_vault

# ------------------------------------------------------------------------------
# 5. Tool Service Integrations (DB-GPT & Data Formulator via OpenRouter)
# ------------------------------------------------------------------------------
# DB-GPT Headless Read-Only DB Service (routed to OpenRouter deepseek/deepseek-v3.2)
DB_GPT_SERVICE_URL=http://localhost:8100
DB_GPT_MODEL=deepseek/deepseek-v3.2
DB_GPT_OPENAI_API_BASE=https://openrouter.ai/api/v1
DB_GPT_READONLY_MODE=true

# Data-Formulator Service (routed to OpenRouter gemini-2.5-flash or deepseek-v3.2)
DATA_FORMULATOR_SERVICE_URL=http://localhost:5000
DATA_FORMULATOR_OPENAI_API_BASE=https://openrouter.ai/api/v1
